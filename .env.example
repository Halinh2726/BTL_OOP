# Sao chép thành .env rồi sửa giá trị. KHÔNG commit file .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=parking
DB_USERNAME=parking
DB_PASSWORD=parking
DB_ROOT_PASSWORD=root
SERVER_PORT=8080

# Cấu hình ngân hàng nhận tiền mặc định trước khi demo (VietQR Napas247).
# Quản lý cũng có thể thay đổi trực tiếp trên giao diện (tab Ngân hàng & Giờ khóa) mà không cần khởi động lại.
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0987654321
VIETQR_ACCOUNT_NAME=BAI XE HOC VIEN PTIT
VIETQR_TEMPLATE=compact2

# Khóa bảo mật xác thực Webhook từ SePay / Casso (header X-API-KEY hoặc Authorization: Apikey <KEY>)
WEBHOOK_API_KEY=sepay_secret_key_123456
