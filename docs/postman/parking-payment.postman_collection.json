    {
      "name": "1. Sinh viên đăng ký tài khoản và xe",
      "item": [
        {
          "name": "Đăng ký sinh viên (SV01)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentCode\": \"{{svCode}}\",\n  \"fullName\": \"Nguyễn Văn Demo\",\n  \"username\": \"{{svUsername}}\",\n  \"password\": \"{{svPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sinh dữ liệu mới mỗi lần chạy để collection chạy lại được nhiều lần",
                  "const n = Date.now().toString().slice(-6);",
                  "pm.collectionVariables.set('svCode', 'DEMO' + n);",
                  "pm.collectionVariables.set('svUsername', 'sv' + n);",
                  "pm.collectionVariables.set('plate', '59X' + n);",
                  "pm.collectionVariables.set('guardUsername', 'baove' + n);",
                  "pm.collectionVariables.set('guardPhone', '09' + n + '00');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('MSSV đúng', () => pm.expect(pm.response.json().studentCode).to.eql(pm.collectionVariables.get('svCode')));"
                ]
              }
            }
          ]
        },
